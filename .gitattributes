# LF in the repository and in every checkout, whatever core.autocrlf is on the machine.
# .editorconfig asks for LF too, so the build's formatting check gives the same result everywhere.
* text=auto eol=lf

# Do not let git change or diff these files
*.msi   binary -delta
*.zip   binary -delta
*.7z    binary -delta
*.gz    binary -delta

*.dll   binary
*.pdb   binary
*.exe   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.pdf   binary
